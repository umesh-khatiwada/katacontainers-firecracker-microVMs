# Copy to .env and tweak if you like. docker-compose.yml already sets sane defaults,
# so you normally do NOT need this file to run the demo.

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PDF_QUEUE=pdf_jobs

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pdfs

# Address browsers on your host use to download results (presigned URL host rewrite).
MINIO_PUBLIC_HOST=localhost:9000
